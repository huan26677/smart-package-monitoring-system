# Mutable defaults. Runtime authentication/users remain in the persisted data volume.
listeners.tcp.default {
  bind = "0.0.0.0:1883"
  enable_authn = true
}

listeners.ws.default {
  bind = "0.0.0.0:8083"
  enable_authn = true
  websocket.mqtt_path = "/mqtt"
}

dashboard.listeners.http.bind = "0.0.0.0:18083"
